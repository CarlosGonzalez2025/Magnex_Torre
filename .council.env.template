# ============================================================
# LLM Council — Configuración de claves API
# ============================================================
# 1. Copia este archivo: cp .council.env.template .council.env
# 2. Pon tus claves REALES en .council.env  (NUNCA en este archivo)
# ============================================================

# ── Opción A: OpenRouter (recomendado)
# Obtener clave → https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# ── Opción B: OpenAI directo (solo si no usas OpenRouter)
# Obtener clave → https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-...

# ── Gemini
# Obtener clave → https://aistudio.google.com/app/apikey  (debe empezar con AIzaSy)
GEMINI_API_KEY=AIzaSy...

# ── Modelos opcionales ────────────────────────────────────────
# OPENAI_MODEL=openai/gpt-4o-mini
# GEMINI_MODEL=gemini-2.0-flash
