# =====================================================
# CONFIGURACIÓN DEL SISTEMA TORRE DE CONTROL
# Copia este archivo como .env y completa los valores
# =====================================================

# SUPABASE (frontend)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# SUPABASE (usadas por el cron /api/geotab-sync en Vercel)
# SUPABASE_URL debe ser el MISMO valor que VITE_SUPABASE_URL (sin prefijo VITE_).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Secreto opcional para proteger /api/geotab-sync; Vercel Cron lo envía como Bearer.
CRON_SECRET=un_secreto_largo_aleatorio

# CONFIGURACIÓN GENERAL
VITE_APP_NAME=Torre de Control
VITE_APP_VERSION=2.0.0
VITE_REFRESH_INTERVAL=300000

# ── RPA Agent Config (Portales Web de GPS) ───────────────────────────────────
# Indicar 'local' para usar el Chrome instalado en la máquina, o la URL ws:// de Browserless en producción.
RPA_BROWSER_WS_ENDPOINT=local

COLTRACK_WEB_LOGIN_URL=https://gps.coltrack.com/gps/login.jsp
COLTRACK_WEB_USER=WebSMagnex
COLTRACK_WEB_PASSWORD=your_coltrack_password_here

FAGOR_WEB_LOGIN_URL=http://www.flotasnet.com/
FAGOR_WEB_USER=WebMasa2024
FAGOR_WEB_PASSWORD=your_fagor_password_here
FAGOR_WEB_COMPANY=masa stork
